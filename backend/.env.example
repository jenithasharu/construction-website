MONGODB_URI=mongodb://127.0.0.1:27017/constructionBD
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# The one admin account used by the dashboard. Store a scrypt hash, never a plain password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$replace_with_salt$replace_with_hash

# Use a long, random secret to sign admin login tokens.
JWT_SECRET=replace_with_a_long_random_secret
